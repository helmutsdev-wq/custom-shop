# ──────────────────────────────────────────────
# Custom Shop — Magento 2 Headless Environment
# ──────────────────────────────────────────────

# Domain / URLs
APP_DOMAIN=custom-shop.local
ADMIN_PATH=admin

# Database (MariaDB)
MARIADB_DATABASE=magento
MARIADB_USER=magento
MARIADB_PASSWORD=changeme
MARIADB_ROOT_PASSWORD=changeme

# OpenSearch
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_PREFIX=magento2

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=magento
RABBITMQ_DEFAULT_PASSWORD=changeme

# Magento Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User
ADMIN_PASSWORD=Admin123

# Magento Auth (Magento Marketplace keys for composer)
MAGENTO_REPO_PUBLIC_KEY=
MAGENTO_REPO_PRIVATE_KEY=

# Mail (Mailpit for dev)
MAIL_HOST=mailpit
MAIL_PORT=1025
